# Seagull - .env template
# Copy to .env before running.

# -----------------------------
# Ports (host)
# -----------------------------
SEAGULL_BACKEND_PORT=127.0.0.1:8000
SEAGULL_PORTAL_PORT=8080
GRAFANA_PORT=3000
SEAGULL_EDGE_HTTP_PORT=8081
SEAGULL_EDGE_HTTPS_PORT=8443
SEAGULL_CADDY_DOMAIN=localhost
SEAGULL_CADDY_EMAIL=
SEAGULL_CADDY_CONFIG_FILE=./infra/caddy/Caddyfile.dev
SEAGULL_TLS_CERT_FILE=./secrets/dev-tls/tls.crt
SEAGULL_TLS_KEY_FILE=./secrets/dev-tls/tls.key

# -----------------------------
# Agent mTLS (internal PKI)
# -----------------------------
SEAGULL_MTLS_ENABLED=true
SEAGULL_AGENT_MTLS_PORT=8444
SEAGULL_PKI_DIR=./secrets/pki
SEAGULL_AGENT_MTLS_CA_FILE=./secrets/pki/agent-ca.crt
SEAGULL_AGENT_CA_VALIDITY_DAYS=3650
SEAGULL_AGENT_CERT_VALIDITY_DAYS=365
SEAGULL_AGENT_CERT_RENEW_BEFORE_DAYS=30
SEAGULL_AGENT_CERT_KEY_SIZE=2048
SEAGULL_AGENT_MTLS_SERVER_NAMES=localhost,127.0.0.1
SEAGULL_SERVER_CA_VALIDITY_DAYS=3650
SEAGULL_SERVER_CERT_VALIDITY_DAYS=365
SEAGULL_SERVER_CERT_RENEW_BEFORE_DAYS=30
SEAGULL_AGENT_MTLS_IDENTITY_BINDING=enforce
SEAGULL_AGENT_CERT_RENEWAL=enabled
# Set true to bring up only the Docker stack and skip the host systemd-agent
# reconcile (CA sync + install). The reconcile is already best-effort: it is
# auto-skipped when systemd/sudo are unavailable and never fails when starting with default seagull commands.
SEAGULL_SKIP_AGENT_RECONCILE=false

# -----------------------------
# Database (PostgreSQL)
# -----------------------------
POSTGRES_DB=seagull
POSTGRES_USER=seagull
# Keep legacy dev default for compatibility with existing local postgres volumes.
POSTGRES_PASSWORD=seagull123
POSTGRES_PASSWORD_FILE=

# Backend constraints/tuning
SEAGULL_ENV=dev
SEAGULL_MAX_EVENT_CLOCK_SKEW_SECONDS=300
SEAGULL_LOG_LEVEL=INFO
# DB lifecycle:
# - true: backend/workers apply Alembic migrations automatically on startup
# - false: require explicit `alembic upgrade head` before startup
SEAGULL_DB_AUTO_UPGRADE=true
# Production override used by compose.prod.yml.
SEAGULL_DB_AUTO_UPGRADE_PROD=true

# Ingest storm control (protect Postgres under volumetric attacks)
SEAGULL_INGEST_MAX_BATCH=10000
SEAGULL_INGEST_STORM_EVENTS_PER_SECOND=8000
SEAGULL_INGEST_STORM_MIN_BATCH=2500
SEAGULL_INGEST_STORM_TTL_SECONDS=20
SEAGULL_INGEST_STORM_SAMPLE_PERCENT=2
SEAGULL_INGEST_VALUES_PAGE_SIZE=1000
SEAGULL_INGEST_ROLLUP_PAGE_SIZE=500
# Ingest backpressure (Redis queue)
SEAGULL_INGEST_QUEUE_KEY=seagull:ingest:queue
SEAGULL_INGEST_PROCESSING_KEY=seagull:ingest:queue:processing
SEAGULL_INGEST_WORKER_BATCH_MESSAGES=50
SEAGULL_INGEST_WORKER_IDLE_SLEEP_SECONDS=0.25
SEAGULL_INGEST_BACKPRESSURE_SOFT_BACKLOG_EVENTS=50000
SEAGULL_INGEST_BACKPRESSURE_HARD_BACKLOG_EVENTS=200000
SEAGULL_INGEST_BACKPRESSURE_MODE=rollup_only
SEAGULL_INGEST_BACKPRESSURE_WARM_SAMPLE_PERCENT=2

# Hot/Warm sampling
SEAGULL_INGEST_WARM_ENABLED=true
SEAGULL_INGEST_WARM_SAMPLE_PERCENT=0
SEAGULL_INGEST_WARM_INDEX_PREFIX=seagull-events-warm
SEAGULL_INGEST_WARM_ILM_ENABLED=true
SEAGULL_INGEST_WARM_ILM_POLICY=seagull-warm-delete-30d
SEAGULL_INGEST_WARM_ILM_DELETE_AFTER_DAYS=30
SEAGULL_INGEST_STORM_HOT_SAMPLE_PERCENT=2
SEAGULL_INGEST_STORM_WARM_SAMPLE_PERCENT=5
SEAGULL_INGEST_STORM_ALERT_TTL_SECONDS=3600
SEAGULL_INGEST_ELEVATED_HOT_SAMPLE_PERCENT=50
SEAGULL_INGEST_DEGRADED_HOT_SAMPLE_PERCENT=5
SEAGULL_INGEST_CRITICAL_HOT_SAMPLE_PERCENT=1
SEAGULL_INGEST_CLICKHOUSE_SAMPLE_PERCENT=100
SEAGULL_INGEST_DEGRADED_CLICKHOUSE_SAMPLE_PERCENT=25
SEAGULL_INGEST_CRITICAL_CLICKHOUSE_SAMPLE_PERCENT=10
SEAGULL_INGEST_MIN_HOT_EVENTS_PER_BATCH=1
SEAGULL_INGEST_MIN_CLICKHOUSE_EVENTS_PER_BATCH=32
SEAGULL_INGEST_RECENT_FEED_MAX_EVENTS=5000
SEAGULL_INGEST_RECENT_FEED_PER_AGENT_MAX_EVENTS=1000
SEAGULL_INGEST_RECENT_FEED_MIN_BATCH=24
SEAGULL_INGEST_RECENT_FEED_LOOKBACK_SECONDS=900
SEAGULL_INGEST_RECENT_FEED_MAX_PUSH_PER_CALL=512

# Elasticsearch ILM
SEAGULL_ES_ILM_ENABLED=true
SEAGULL_ES_ILM_DELETE_AFTER_DAYS=30
SEAGULL_ES_ILM_POLICY_NAME=

# --------------------------------
# Portal auth (JWT + bootstrap admin)
# --------------------------------
# Strong secret (>= 32 chars). Generate with:
#   openssl rand -hex 32
SEAGULL_JWT_SECRET=change_me_dev_jwt_secret_at_least_32_chars_long
SEAGULL_JWT_SECRET_FILE=
SEAGULL_TOKEN_PEPPER=
SEAGULL_JWT_ISSUER=seagull-backend
SEAGULL_JWT_AUDIENCE=seagull-portal
SEAGULL_ACCESS_TOKEN_TTL_SECONDS=600
SEAGULL_REFRESH_TOKEN_TTL_SECONDS=604800
SEAGULL_OTP_TOKEN_TTL_SECONDS=900
SEAGULL_AUTH_OTP_ENABLED=true
SEAGULL_BOOTSTRAP_ADMIN_USERNAME=admin
SEAGULL_BOOTSTRAP_ADMIN_PASSWORD=NwPortal!9342Qx
SEAGULL_BOOTSTRAP_ADMIN_PASSWORD_FILE=
SEAGULL_BOOTSTRAP_ADMIN_RESET_ON_START=true
# Break-glass only: startup sync is blocked unless BOTH flags below are true.
SEAGULL_BOOTSTRAP_ADMIN_SYNC_ON_START=false
SEAGULL_BOOTSTRAP_ADMIN_ALLOW_SYNC_ON_START=false
SEAGULL_AUTH_OTP_ENABLED_PROD=false
SEAGULL_AGENT_BOOTSTRAP_TOKEN_TTL_SECONDS=900
SEAGULL_AGENT_BOOTSTRAP_TOKEN_MAX_USES=1
SEAGULL_AGENT_CREDENTIAL_TTL_SECONDS=604800
SEAGULL_AGENT_CREDENTIAL_MAX_USES=100000
SEAGULL_AGENT_CREDENTIAL_ROTATE_BEFORE_SECONDS=86400
SEAGULL_AGENT_CREDENTIAL_OVERLAP_SECONDS=900
SEAGULL_AGENT_RENEWAL_TOKEN_TTL_SECONDS=2592000
SEAGULL_AGENT_RENEWAL_TOKEN_MAX_ACTIVE=2
SEAGULL_FORCE_ENROLL_ON_START=true
SEAGULL_MAINTENANCE_ENABLE_BOOTSTRAP_ROTATOR=false
SEAGULL_BOOTSTRAP_ROTATOR_AGENT_IDS=agent-core-1,agent-sensor-1,agent-lateral-1,agent-proc-1,agent-scan-1,agent-ddos-1,agent-vuln-1
SEAGULL_BOOTSTRAP_ROTATOR_TOKEN_TTL_SECONDS=2592000
SEAGULL_BOOTSTRAP_ROTATOR_TOKEN_MAX_USES=5
SEAGULL_BOOTSTRAP_ROTATOR_EVERY_SECONDS=900
SEAGULL_BOOTSTRAP_ROTATOR_REFRESH_BEFORE_SECONDS=86400
SEAGULL_BOOTSTRAP_ROTATOR_EDGE_BASE=
SEAGULL_BOOTSTRAP_ROTATOR_BACKEND_BASE=http://seagull-backend:8000
SEAGULL_BOOTSTRAP_ROTATOR_OUTPUT_DIR=/etc/seagull/bootstrap
SEAGULL_BOOTSTRAP_ROTATOR_STATE_DIR=/var/lib/seagull/bootstrap-rotator
SEAGULL_ALLOWED_HOSTS=*
# Production override used by compose.prod.yml (keeps dev wildcard isolated).
SEAGULL_ALLOWED_HOSTS_PROD=localhost,127.0.0.1
SEAGULL_COOKIE_SECURE=false
SEAGULL_COOKIE_SAMESITE=lax
SEAGULL_COOKIE_DOMAIN=
SEAGULL_ENABLE_HSTS=false
SEAGULL_TRUST_PROXY_HEADERS=false
SEAGULL_TRUSTED_PROXY_CIDRS=127.0.0.1,::1
SEAGULL_AUDIT_HASH_PEPPER=
SEAGULL_AUDIT_HASH_PEPPER_FILE=
SEAGULL_AUDIT_RETENTION_ENABLED=true
SEAGULL_AUDIT_RETENTION_DAYS=30
SEAGULL_LOGIN_AUDIT_RETENTION_DAYS=30
SEAGULL_GOVERNANCE_RETENTION_DAYS=30
# Production overrides used by compose.prod.yml.
SEAGULL_AUDIT_RETENTION_DAYS_PROD=365
SEAGULL_LOGIN_AUDIT_RETENTION_DAYS_PROD=365
SEAGULL_GOVERNANCE_RETENTION_DAYS_PROD=365
SEAGULL_AUDIT_RETENTION_EVERY_SECONDS=3600
SEAGULL_AUDIT_RETENTION_DELETE_BATCH=5000
SEAGULL_ROLLUP_1S_RETENTION_DAYS=5

# Default agent config applied on first enroll (JSON object).
# Tip: keep it small; the backend enforces SEAGULL_MAX_AGENT_CONFIG_BYTES.
SEAGULL_DEFAULT_AGENT_CONFIG_JSON='{"modules":{"syscollector":{"enabled":true,"every":"5m","cmd_timeout":"10s","max_output_bytes":8388608,"max_packages":50000}}}'
SEAGULL_MAX_AGENT_CONFIG_BYTES=262144

# -----------------------------
# Grafana Admin
# -----------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_dev_grafana_password_123
GF_SECURITY_ADMIN_PASSWORD_FILE=

# -----------------------------
# Rules worker
# -----------------------------
SEAGULL_RULES_EVERY_SECONDS=5
SEAGULL_RULES_ENV=dev
SEAGULL_RULES_ENABLED_PACKS=core,network,host,lab
SEAGULL_RULES_DISABLED_PACKS=
SEAGULL_RULES_INCLUDE_EXPERIMENTAL=true

# Host/network anomaly heuristics
SEAGULL_HEUR_MAX_ROWS=50000
SEAGULL_HEUR_BEACON_WINDOW_SECONDS=3600
SEAGULL_HEUR_BEACON_MIN_EVENTS=7
SEAGULL_HEUR_BEACON_COOLDOWN_SECONDS=900
SEAGULL_HEUR_EXFIL_BASELINE_SECONDS=86400
SEAGULL_HEUR_EXFIL_WINDOW_SECONDS=600
SEAGULL_HEUR_EXFIL_MIN_EVENTS=8
SEAGULL_HEUR_EXFIL_MIN_BYTES=8388608
SEAGULL_HEUR_EXFIL_COOLDOWN_SECONDS=1200
SEAGULL_HEUR_EGRESS_BASELINE_SECONDS=21600

# UEBA worker (runs inside seagull-intelligence-worker)
SEAGULL_UEBA_ENABLED=true
SEAGULL_UEBA_INTERVAL_SECONDS=60
SEAGULL_UEBA_FAILING_AFTER=3
SEAGULL_UEBA_COOLDOWN_MINUTES=60
SEAGULL_UEBA_MAX_FINDINGS_PER_DETECTOR_CYCLE=20
SEAGULL_UEBA_ACTIVE_ENTITY_HOURS=24

# SSH login-hour detector
SEAGULL_UEBA_LOGIN_HOUR_LOOKBACK_HOURS=72
SEAGULL_UEBA_LOGIN_HOUR_MIN_SAMPLES=20
SEAGULL_UEBA_LOGIN_HOUR_MAX_EVENTS_PER_CYCLE=500
SEAGULL_UEBA_LOGIN_HOUR_MIN_RARITY_BITS=3.0
SEAGULL_UEBA_LOGIN_HOUR_MIN_Z_SCORE=2.5

# SSH source-diversity detector
SEAGULL_UEBA_SOURCE_DIVERSITY_WINDOW_MINUTES=15
SEAGULL_UEBA_SOURCE_DIVERSITY_MIN_SAMPLES=12
SEAGULL_UEBA_SOURCE_DIVERSITY_MAX_ENTITIES_PER_CYCLE=500
SEAGULL_UEBA_SOURCE_DIVERSITY_MAX_WINDOWS_PER_CYCLE=4
SEAGULL_UEBA_SOURCE_DIVERSITY_MIN_Z_SCORE=3.0

# Outbound bytes burst detector
SEAGULL_UEBA_OUTBOUND_BYTES_WINDOW_MINUTES=15
SEAGULL_UEBA_OUTBOUND_BYTES_MIN_SAMPLES=10
SEAGULL_UEBA_OUTBOUND_BYTES_MAX_ENTITIES_PER_CYCLE=200
SEAGULL_UEBA_OUTBOUND_BYTES_MAX_WINDOWS_PER_CYCLE=4
SEAGULL_UEBA_OUTBOUND_BYTES_MIN_Z_SCORE=3.5

# Lateral spread detector
SEAGULL_UEBA_LATERAL_SPREAD_WINDOW_MINUTES=15
SEAGULL_UEBA_LATERAL_SPREAD_MIN_SAMPLES=8
SEAGULL_UEBA_LATERAL_SPREAD_MAX_ENTITIES_PER_CYCLE=200
SEAGULL_UEBA_LATERAL_SPREAD_MAX_WINDOWS_PER_CYCLE=4
SEAGULL_UEBA_LATERAL_SPREAD_MIN_Z_SCORE=3.0

# Process exec-rate detector
SEAGULL_UEBA_PROC_EXEC_RATE_WINDOW_MINUTES=5
SEAGULL_UEBA_PROC_EXEC_RATE_MIN_SAMPLES=12
SEAGULL_UEBA_PROC_EXEC_RATE_MAX_ENTITIES_PER_CYCLE=200
SEAGULL_UEBA_PROC_EXEC_RATE_MAX_WINDOWS_PER_CYCLE=6
SEAGULL_UEBA_PROC_EXEC_RATE_MIN_Z_SCORE=4.0

# Rare process-name detector
SEAGULL_UEBA_PROC_NAME_LOOKBACK_HOURS=72
SEAGULL_UEBA_PROC_NAME_MAX_EVENTS_PER_CYCLE=1000
SEAGULL_UEBA_PROC_NAME_MIN_RARITY_BITS=4.0
SEAGULL_UEBA_PROC_NAME_MIN_SAMPLES_FOR_MATURITY=5
SEAGULL_UEBA_PROC_NAME_RARITY_LOOKBACK_HOURS=168

# FIM spike detector
SEAGULL_UEBA_FIM_SPIKE_WINDOW_MINUTES=5
SEAGULL_UEBA_FIM_SPIKE_MIN_SAMPLES=10
SEAGULL_UEBA_FIM_SPIKE_MAX_ENTITIES_PER_CYCLE=100
SEAGULL_UEBA_FIM_SPIKE_MAX_WINDOWS_PER_CYCLE=6
SEAGULL_UEBA_FIM_SPIKE_MIN_Z_SCORE=4.0

# Sudo session-hour detector
SEAGULL_UEBA_SUDO_HOUR_LOOKBACK_HOURS=72
SEAGULL_UEBA_SUDO_HOUR_MIN_SAMPLES=15
SEAGULL_UEBA_SUDO_HOUR_MAX_EVENTS_PER_CYCLE=500
SEAGULL_UEBA_SUDO_HOUR_MIN_RARITY_BITS=3.0
SEAGULL_UEBA_SUDO_HOUR_MIN_Z_SCORE=2.5

# Isolation Forest model (rare_process_name_v1)
SEAGULL_UEBA_IF_BLEND_WEIGHT=0.6
SEAGULL_UEBA_RARITY_BLEND_WEIGHT=0.4
SEAGULL_UEBA_IF_TRAINING_MIN_SAMPLES=500
SEAGULL_UEBA_IF_RETRAINING_INTERVAL_SECONDS=21600
SEAGULL_UEBA_IF_MODEL_STALE_SECONDS=86400
SEAGULL_UEBA_IF_MODEL_RETENTION_DAYS=30
SEAGULL_UEBA_IF_MODEL_CACHE_TTL_SECONDS=300
SEAGULL_UEBA_IF_N_ESTIMATORS=200
SEAGULL_UEBA_IF_RANDOM_STATE=42
SEAGULL_UEBA_IF_FEATURE_SCHEMA_VERSION=1
SEAGULL_UEBA_IF_CONTAMINATION=auto

# Peer group deviation detector
SEAGULL_UEBA_PEER_CLUSTERING_INTERVAL_SECONDS=21600
SEAGULL_UEBA_PEER_GROUP_RETENTION_DAYS=90
SEAGULL_UEBA_PEER_MIN_SILHOUETTE_SCORE=0.25
SEAGULL_UEBA_PEER_DISTANCE_PERCENTILE=95.0
SEAGULL_UEBA_PEER_CURRENT_WINDOW_MINUTES=60
SEAGULL_UEBA_PEER_FEATURE_SCHEMA_VERSION=1
SEAGULL_UEBA_PEER_MIN_AGENTS=4
SEAGULL_UEBA_PEER_MIN_MATURE_DAYS=3
SEAGULL_UEBA_PEER_MAX_EVENTS_PER_CLUSTERING=50000

# UEBA analyst feedback projection
SEAGULL_UEBA_FEEDBACK_FP_CONFIDENCE_FACTOR=15.0
SEAGULL_UEBA_FEEDBACK_FP_DECAY=0.6
SEAGULL_UEBA_FEEDBACK_FP_SENSITIVITY_STEP=0.5
SEAGULL_UEBA_FEEDBACK_TP_CONFIDENCE_REINFORCE=10.0
SEAGULL_UEBA_FEEDBACK_TP_COOLDOWN_SCALE=0.5
SEAGULL_UEBA_FEEDBACK_BENIGN_CONFIDENCE_FACTOR=5.0
SEAGULL_UEBA_FEEDBACK_MAX_CONFIDENCE_DELTA=60
SEAGULL_UEBA_FEEDBACK_MAX_SENSITIVITY_SCALE=8.0
SEAGULL_UEBA_FEEDBACK_DEFAULT_SUPPRESSION_TTL_SECONDS=86400
SEAGULL_HEUR_EGRESS_WINDOW_SECONDS=900
SEAGULL_HEUR_EGRESS_MIN_EVENTS=5
SEAGULL_HEUR_EGRESS_MIN_BYTES=2097152
SEAGULL_HEUR_EGRESS_SPIKE_FACTOR=2.5
SEAGULL_HEUR_EGRESS_RARE_BASELINE_EVENTS=3
SEAGULL_HEUR_EGRESS_CORRELATION_SECONDS=900
SEAGULL_HEUR_EGRESS_COOLDOWN_SECONDS=1200

# -----------------------------
# Agent -> Backend / Control Plane
# -----------------------------
SEAGULL_API_URL=https://localhost:8444/agent
SEAGULL_AGENT_TLS_SERVER_NAME=localhost
SEAGULL_AGENT_SERVER_CA_FILE=./secrets/tls/ca.crt

# -----------------------------
# Agent IDs
# -----------------------------
AGENT_CORE_ID=agent-core-1
AGENT_SENSOR_ID=agent-sensor-1
AGENT_LATERAL_ID=agent-lateral-1

# Optional one-time bootstrap tokens for initial enroll / break-glass recovery.
AGENT_CORE_BOOTSTRAP_TOKEN=
AGENT_SENSOR_BOOTSTRAP_TOKEN=
AGENT_LATERAL_BOOTSTRAP_TOKEN=
AGENT_CORE_BOOTSTRAP_TOKEN_FILE=
AGENT_SENSOR_BOOTSTRAP_TOKEN_FILE=
AGENT_LATERAL_BOOTSTRAP_TOKEN_FILE=

# Optional split-agent identities (extra systemd hosts)
AGENT_PROC_ID=
AGENT_SCAN_ID=
AGENT_DDOS_ID=
AGENT_VULN_ID=
AGENT_PROC_BOOTSTRAP_TOKEN=
AGENT_SCAN_BOOTSTRAP_TOKEN=
AGENT_DDOS_BOOTSTRAP_TOKEN=
AGENT_VULN_BOOTSTRAP_TOKEN=
AGENT_PROC_BOOTSTRAP_TOKEN_FILE=
AGENT_SCAN_BOOTSTRAP_TOKEN_FILE=
AGENT_DDOS_BOOTSTRAP_TOKEN_FILE=
AGENT_VULN_BOOTSTRAP_TOKEN_FILE=

# -----------------------------
# Elasticsearch (search / hunting)
# -----------------------------
# Single-node defaults are tuned for small VPS labs. Start Kibana with:
#   docker compose --profile extra up -d
# SECURITY: bind infra ports to loopback. Publishing them as bare ports
# (e.g. 9200) exposes unauthenticated Elasticsearch/ClickHouse to the
# internet on a public host. Leave empty to not publish at all.
ELASTICSEARCH_PORT=127.0.0.1:9200
KIBANA_PORT=5601
CLICKHOUSE_HTTP_PORT=127.0.0.1:8123
CLICKHOUSE_NATIVE_PORT=127.0.0.1:9000
SEAGULL_KIBANA_PUBLIC_BASE_URL=https://localhost/kibana

# Elasticsearch URL as seen by containers.
SEAGULL_SEARCH_BACKEND=auto
SEAGULL_ES_URL=http://elasticsearch:9200
SEAGULL_ES_INDEX_PREFIX=seagull-events
SEAGULL_ES_BATCH_SIZE=500
SEAGULL_ES_EVERY_SECONDS=1
SEAGULL_ES_IDLE_SLEEP_SECONDS=2
SEAGULL_ES_REQUEST_TIMEOUT_SECONDS=30
SEAGULL_ES_USERNAME=elastic
SEAGULL_ES_PASSWORD=
SEAGULL_ES_PASSWORD_FILE=
# Internal-only passthrough variable used by container healthchecks.
ELASTIC_PASSWORD_FILE=
SEAGULL_ES_VERIFY_CERTS=true
SEAGULL_ES_CA_CERTS=
SEAGULL_ES_PING_TTL_SECONDS=2
SEAGULL_ES_BOOTSTRAP=true

# -----------------------------
# ClickHouse (analytics / telemetry at scale)
# -----------------------------
SEAGULL_CLICKHOUSE_ENABLED=true
SEAGULL_CLICKHOUSE_REQUIRED=false
SEAGULL_CLICKHOUSE_HOST=clickhouse
SEAGULL_CLICKHOUSE_PORT=8123
SEAGULL_CLICKHOUSE_DATABASE=seagull
SEAGULL_CLICKHOUSE_USERNAME=default
SEAGULL_CLICKHOUSE_PASSWORD=
SEAGULL_CLICKHOUSE_SECURE=false
SEAGULL_CLICKHOUSE_VERIFY=true
SEAGULL_CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=2
SEAGULL_CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=30
# Backfill/materialization statements may run for tens of seconds; never below
# the slowest expected chunk INSERT or the materializer restarts forever.
SEAGULL_CLICKHOUSE_LONG_OPS_TIMEOUT_SECONDS=300
SEAGULL_CLICKHOUSE_PING_TTL_SECONDS=2
SEAGULL_CLICKHOUSE_EVENTS_TABLE=net_events_raw
SEAGULL_CLICKHOUSE_EVENTS_RETENTION_DAYS=30
SEAGULL_CLICKHOUSE_RECONNECT_SECONDS=5
SEAGULL_CLICKHOUSE_BACKFILL_FROM_ID=0
SEAGULL_CLICKHOUSE_BACKFILL_BATCH_SIZE=2000
SEAGULL_CLICKHOUSE_BACKFILL_MAX_ROWS=0
SEAGULL_CLICKHOUSE_BACKFILL_SLEEP_SECONDS=0
SEAGULL_CLICKHOUSE_BACKFILL_AGENT_ID=
SEAGULL_REDIS_USERNAME=
# Redis is ephemeral by default in dev and persistent when DEV_REDIS_PERSIST=1 or in prod.
SEAGULL_REDIS_PASSWORD=
SEAGULL_REDIS_PASSWORD_FILE=

# Postgres tuning (applied via compose command flags)
# Suggested on a VPS where Postgres has the host mostly to itself: 512MB-1GB.
SEAGULL_PG_SHARED_BUFFERS=128MB

# Backend performance tuning
SEAGULL_UVICORN_WORKERS=2
SEAGULL_DB_POOL_SIZE=10
SEAGULL_DB_MAX_OVERFLOW=20
SEAGULL_DB_EXECUTEMANY_MODE=values_plus_batch
SEAGULL_DB_EXECUTEMANY_VALUES_PAGE_SIZE=1000

# Rollup worker (reduce Grafana/Postgres load)
SEAGULL_ROLLUP_EVERY_SECONDS=1
SEAGULL_ROLLUP_IDLE_SLEEP_SECONDS=2
SEAGULL_ROLLUP_MAX_ROWS=5000

# -----------------------------
# Analytics read models (prewarm / materialize)
# -----------------------------
# Keep FRESH_SECONDS comfortably above PREWARM_EVERY_SECONDS, otherwise every
# prewarm cycle recomputes the whole spec fan-out from scratch.
SEAGULL_EVENTS_SUMMARY_FRESH_SECONDS=240
SEAGULL_EVENTS_SUMMARY_STALE_SECONDS=1800
SEAGULL_ANALYTICS_PREWARM_EVERY_SECONDS=120
SEAGULL_ANALYTICS_PREWARM_TOP_AGENTS=3
SEAGULL_ANALYTICS_MATERIALIZE_EVERY_SECONDS=300
SEAGULL_PROTO_INTEL_BACKFILL_CHUNK_HOURS=6
SEAGULL_PROTO_INTEL_BACKFILL_SLEEP_SECONDS=0.5

# -----------------------------
# Dashboard snapshots (CQRS read models materialized in Postgres)
# -----------------------------
# Worker "dashboard-snapshots" (intelligence group) recomputes hot dashboard pages
# every tick and stores them in the dashboard_snapshots table; handlers serve the
# stored payload and fall back to inline compute when missing/stale.
# One flag per page allows incremental rollout/rollback.
SEAGULL_SNAPSHOTS_WORKER_ENABLED=true
SEAGULL_SNAPSHOTS_EVERY_SECONDS=30
# Handler serves a snapshot up to MULTIPLIER x EVERY_SECONDS old; older -> inline compute.
SEAGULL_SNAPSHOTS_MAX_AGE_MULTIPLIER=6
# Dynamic scopes (overview per agent/window) recompute only what was consulted recently.
SEAGULL_SNAPSHOTS_DYNAMIC_WINDOW_HOURS=6
SEAGULL_SNAPSHOTS_DYNAMIC_MAX_SCOPES=20
SEAGULL_SNAPSHOTS_RETENTION_HOURS=24
SEAGULL_SNAPSHOT_OVERVIEW_ENABLED=true
SEAGULL_SNAPSHOT_OVERVIEW_WINDOWS=60,360,1440
SEAGULL_SNAPSHOT_EXPOSURE_SUMMARY_ENABLED=true
SEAGULL_SNAPSHOT_VULN_SUMMARY_ENABLED=true
SEAGULL_SNAPSHOT_VULN_POSTURE_ENABLED=true
SEAGULL_SNAPSHOT_TOPOLOGY_SUMMARY_ENABLED=true

# -----------------------------
# IP Intelligence (Geo/ASN for SSH Insights)
# -----------------------------
# Primary mode: local MaxMind GeoLite2 MMDB databases mounted inside the backend and worker.
# Drop the files below into backend/data/geoip/ on the host.
MAXMIND_LICENSE_KEY=
SEAGULL_IP_INTEL_PROVIDER=auto
SEAGULL_IP_INTEL_FALLBACK_PROVIDER=ipinfo
SEAGULL_IP_INTEL_MAXMIND_CITY_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb
SEAGULL_IP_INTEL_MAXMIND_ASN_DB_PATH=/app/data/geoip/GeoLite2-ASN.mmdb
# Optional fallback only. Leave empty if you want local-only enrichment.
SEAGULL_IPINFO_TOKEN=
SEAGULL_IP_INTEL_EVERY_SECONDS=1.0
SEAGULL_IP_INTEL_IDLE_SLEEP_SECONDS=2.0
SEAGULL_IP_INTEL_MAX_ROWS=2000
SEAGULL_IP_INTEL_BATCH_SIZE=200
SEAGULL_IP_INTEL_HTTP_TIMEOUT_SECONDS=8.0
SEAGULL_IP_INTEL_CACHE_TTL_DAYS=7
SEAGULL_IP_INTEL_SKIP_PRIVATE=true
# Comma-separated CIDRs treated as internal networks (e.g. corporate VPN ranges).
# Takes precedence over generic RFC1918 classification. Leave empty to use built-in ranges only.
SEAGULL_INTERNAL_NETWORK_CIDRS=

# -----------------------------
# Protocol Intelligence (DNS/HTTP/TLS)
# -----------------------------
SEAGULL_PROTO_INTEL_EVERY_SECONDS=1.0
SEAGULL_PROTO_INTEL_IDLE_SLEEP_SECONDS=2.0
SEAGULL_PROTO_INTEL_MAX_ROWS=5000
SEAGULL_PROTO_INTEL_BATCH_SIZE=500
SEAGULL_PROTO_INTEL_PAYLOAD_MAX_BYTES=4096
# Optional: override app protocol guesses by port. Format: proto:80,8080;dns:53;postgresql:5432
SEAGULL_PROTO_INTEL_PORT_HINTS=

# -----------------------------
# Attack Chain (stateful kill-chain cases)
# -----------------------------
SEAGULL_ATTACK_CHAIN_EVERY_SECONDS=1.0
SEAGULL_ATTACK_CHAIN_IDLE_SLEEP_SECONDS=2.0
SEAGULL_ATTACK_CHAIN_BATCH_SIZE=500

# Worker logs
# - LOG_EVERY: prints an "ok" line with detailed counters at most every N seconds
# - LOG_IDLE_EVERY: prints an "idle" heartbeat when there are no new events
# - DEBUG: prints one line per inserted step (useful for tuning detectors)
SEAGULL_ATTACK_CHAIN_LOG_EVERY_SECONDS=2.0
SEAGULL_ATTACK_CHAIN_LOG_IDLE_EVERY_SECONDS=20.0
SEAGULL_ATTACK_CHAIN_DEBUG=false

# Auto-close open cases that went idle (seconds)
SEAGULL_ATTACK_CHAIN_IDLE_CLOSE_SECONDS=2700

# Attach local-only steps (sudo/exec/persistence) to the latest open case for the agent (seconds)
SEAGULL_ATTACK_CHAIN_ATTACH_LOCAL_WINDOW_SECONDS=1200

# Deduplicate identical steps within this window (seconds)
SEAGULL_ATTACK_CHAIN_STEP_DEDUP_SECONDS=60

SEAGULL_ATTACK_CHAIN_MAX_SCORE=100

# SSH correlation tuning
SEAGULL_ATTACK_CHAIN_SSH_FAIL_WINDOW_SECONDS=600
SEAGULL_ATTACK_CHAIN_SSH_FAIL_THRESHOLD=6
SEAGULL_ATTACK_CHAIN_SSH_BRUTEFORCE_SCORE=28
SEAGULL_ATTACK_CHAIN_SSH_BRUTEFORCE_SUCCESS_SCORE=34
SEAGULL_ATTACK_CHAIN_SSH_NEW_SOURCE_SCORE=14

# Sudo correlation tuning
SEAGULL_ATTACK_CHAIN_SUDO_EXEC_SCORE=6
SEAGULL_ATTACK_CHAIN_SUDO_LOLBIN_SCORE=14
SEAGULL_ATTACK_CHAIN_SUDO_PRIV_ESCALATION_SCORE=24
SEAGULL_ATTACK_CHAIN_SUDO_REMOTE_EXEC_SCORE=26
SEAGULL_ATTACK_CHAIN_SUDO_DEF_EVASION_SCORE=30

# Misc
SEAGULL_ATTACK_CHAIN_LOG_TAMPER_SCORE=22

# -----------------------------
# Exposure & Attack Path Graph
# -----------------------------
# Set false to disable the exposure worker entirely.
SEAGULL_EXPOSURE_ENABLED=true
# How often the worker runs a full posture refresh cycle (seconds).
SEAGULL_EXPOSURE_EVERY_SECONDS=300
# How many net_events rows to process per incremental batch.
SEAGULL_EXPOSURE_EVENT_BATCH_SIZE=500
# How far back to look when bootstrapping the event window (hours).
SEAGULL_EXPOSURE_LOOKBACK_HOURS=48
# Maximum open findings stored per asset.
SEAGULL_EXPOSURE_MAX_FINDINGS_PER_ASSET=100
# Minimum interval between score-history snapshots per asset (seconds).
SEAGULL_EXPOSURE_SCORE_HISTORY_EVERY_SECONDS=3600
# Minutes without a heartbeat before an agent is considered stale.
SEAGULL_EXPOSURE_STALE_AGENT_MINUTES=60
# Hours without an inventory update before an asset is considered stale.
SEAGULL_EXPOSURE_STALE_INVENTORY_HOURS=24
# Hard upper bound on graph nodes returned per asset.
SEAGULL_EXPOSURE_MAX_GRAPH_NODES_PER_ASSET=200
# Hard upper bound on graph edges returned per asset.
SEAGULL_EXPOSURE_MAX_GRAPH_EDGES_PER_ASSET=300

# -----------------------------
# Vulnerability Findings (scanner ingest)
# -----------------------------
# Hard limits to keep ingest lightweight and resilient.
SEAGULL_VULN_MAX_FINDINGS_PER_INGEST=2000
SEAGULL_VULN_MAX_EVIDENCE_BYTES=32768

# If a finding was marked as fixed/resolved and reappears, automatically reopen it.
SEAGULL_VULN_AUTO_REOPEN=true

# -----------------------------
# Agent Vulnerability Scanner (Wazuh-like profile)
# -----------------------------
# Uses host package inventory + OSV correlation + exposure-aware prioritization.
SEAGULL_VULN_ANALYSIS_PROFILE=wazuh_like_v1
SEAGULL_VULN_EXPOSURE_ENABLED=true
