# NetWatch - .env template
# Copy/auto-generate to .env before running

# -----------------------------
# Ports (host)
# -----------------------------
NETWATCH_BACKEND_PORT=8000
GRAFANA_PORT=3000

# -----------------------------
# Database (PostgreSQL)
# -----------------------------
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=change_me

# Backend constraints/tuning
NETWATCH_MAX_EVENT_CLOCK_SKEW_SECONDS=300

# -----------------------------
# Grafana Admin
# -----------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# -----------------------------
# Rules worker
# -----------------------------
NETWATCH_RULES_EVERY_SECONDS=5

# -----------------------------
# Agent -> Backend / Control Plane
# (Your agents use network_mode: host, and NETWATCH_API_URL is set in compose to:
#   http://127.0.0.1:${NETWATCH_BACKEND_PORT}
# This is OK because the backend is published on the host port.)
# -----------------------------
NETWATCH_HTTP_TIMEOUT=5s
NETWATCH_CONTROL_HEARTBEAT_EVERY=10s
NETWATCH_CONTROL_CONFIG_EVERY=30s

# -----------------------------
# Capture / filtering (agents)
# -----------------------------
# Primary pcap iface (used by agents that need it)
NETWATCH_PCAP_IFACE=eth0

# Booleans as "true"/"false"
NETWATCH_SKIP_LOOPBACK=true
NETWATCH_SKIP_LINK_LOCAL=true

# Comma-separated lists (leave empty to disable)
NETWATCH_DENY_CIDRS=
NETWATCH_DENY_DST_PORTS=

# -----------------------------
# Agent IDs
# -----------------------------
AGENT_PROC_ID=agent-proc-1
AGENT_SCAN_ID=agent-scan-1
AGENT_DDOS_ID=agent-ddos-1
AGENT_LATERAL_ID=agent-lateral-1

# -----------------------------
# DDoS module tuning (agent-ddos)
# -----------------------------
# Example: how many consecutive windows to confirm sustained attack
NETWATCH_DDOS_SUSTAIN_WINDOWS=3
# Example: cooldown before re-alerting (duration)
NETWATCH_DDOS_COOLDOWN=30s

# -----------------------------
# Lateral module (profile: extra)
# -----------------------------
NETWATCH_LATERAL_MODE=passive
NETWATCH_LATERAL_PCAP_IFACE=eth0
NETWATCH_LATERAL_PORTS=22,80,443
NETWATCH_LATERAL_INCLUDE_ESTABLISHED=false
NETWATCH_LATERAL_DEDUP_TTL=60s
NETWATCH_LATERAL_MAX_BATCH=500
