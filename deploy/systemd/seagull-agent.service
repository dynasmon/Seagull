[Unit]
Description=Seagull Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seagull
Group=seagull

EnvironmentFile=/etc/seagull/agent.env
ExecStart=/usr/local/bin/seagull-agent

Restart=always
RestartSec=5
TimeoutStopSec=20

StateDirectory=seagull
LogsDirectory=seagull
RuntimeDirectory=seagull

NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_KILL
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_KILL
LimitNOFILE=65536

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadWritePaths=/var/lib/seagull /var/log/seagull /run/seagull /var/lib/seagull/quarantine
ReadOnlyPaths=/etc/seagull -/var/log/auth.log

[Install]
WantedBy=multi-user.target
