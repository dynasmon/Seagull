SEAGULL_AGENT_ID=agent-core-1
SEAGULL_API_URL=https://127.0.0.1:8443/agent
SEAGULL_SOURCES=authlog,proc,scan,ddos,l7,syscollector,vuln

SEAGULL_POLL_INTERVAL=1s
SEAGULL_HTTP_TIMEOUT=10s
SEAGULL_SENDER_MAX_BATCH=300

SEAGULL_AGENT_CONFIG_FILE=/var/lib/seagull/agent.config.json
SEAGULL_AGENT_IDENTITY_STATE_FILE=/var/lib/seagull/agent.identity.json
SEAGULL_AGENT_CREDENTIAL_FILE=/var/lib/seagull/agent.credential

SEAGULL_AGENT_BOOTSTRAP_TOKEN=
SEAGULL_AGENT_BOOTSTRAP_TOKEN_FILE=/var/lib/seagull/bootstrap.token
SEAGULL_AGENT_CREDENTIAL=

SEAGULL_TLS_CA_FILE=/etc/seagull/pki/root_ca.crt
SEAGULL_TLS_CERT_FILE=
SEAGULL_TLS_KEY_FILE=
SEAGULL_TLS_SERVER_NAME=

SEAGULL_CONTROL_HEARTBEAT_EVERY=30s
SEAGULL_CONTROL_HEARTBEAT_JITTER=5s
SEAGULL_CONTROL_CONFIG_EVERY=5m
SEAGULL_CONTROL_CONFIG_JITTER=30s
SEAGULL_CONTROL_RESPONSE_ACTIONS_POLL_EVERY=15s
SEAGULL_CONTROL_RESPONSE_ACTIONS_POLL_JITTER=5s
SEAGULL_CONTROL_ENROLL_TIMEOUT=10s
SEAGULL_FORCE_ENROLL_ON_START=true
SEAGULL_CONTROL_CREDENTIAL_ROTATE_EVERY=5m
SEAGULL_CONTROL_CREDENTIAL_ROTATE_BEFORE=24h

SEAGULL_RESPONSE_ACTION_STAGE_MAX=512

SEAGULL_SYSCOLLECT_EVERY=5m
SEAGULL_SYSCOLLECT_STARTUP_JITTER=45s
SEAGULL_SYSCOLLECT_CMD_TIMEOUT=10s
SEAGULL_SYSCOLLECT_MAX_OUTPUT_BYTES=8388608
SEAGULL_SYSCOLLECT_MAX_PACKAGES=50000
SEAGULL_HOST_ROOT=

SEAGULL_VULN_SCAN_EVERY=12h
SEAGULL_VULN_STARTUP_JITTER=2m
SEAGULL_VULN_OSV_URL=https://api.osv.dev
SEAGULL_VULN_MIN_SEVERITY=medium
SEAGULL_VULN_ANALYSIS_PROFILE=wazuh_like_v1
SEAGULL_VULN_EXPOSURE_ENABLED=true
SEAGULL_VULN_QUERY_BATCH_SIZE=200
SEAGULL_VULN_CMD_TIMEOUT=15s
SEAGULL_VULN_HTTP_TIMEOUT=60s
SEAGULL_VULN_MAX_OUTPUT_BYTES=8388608
SEAGULL_VULN_MAX_PACKAGES=50000
SEAGULL_VULN_HOST_ROOT=
SEAGULL_VULN_EMIT_SUMMARY_EVENT=true

SEAGULL_AUTHLOG_PATH=/var/log/auth.log
SEAGULL_AUTHLOG_INCLUDE_ACCEPTED=true
SEAGULL_AUTHLOG_DEDUP_TTL=1s

SEAGULL_DDOS_SUSTAIN_WINDOWS=1
SEAGULL_DDOS_COOLDOWN=10s
SEAGULL_DDOS_MAX_BATCH=200
SEAGULL_DDOS_BACKPRESSURE_HIGH_WATERMARK=160
SEAGULL_DDOS_BACKPRESSURE_SAMPLE_EVERY=4

SEAGULL_L7_PCAP_IFACE=any
SEAGULL_L7_DEDUP_TTL=20s
SEAGULL_L7_MAX_BATCH=400
SEAGULL_L7_MAX_PAYLOAD_BYTES=512
SEAGULL_L7_INCLUDE_PAYLOAD=false

SEAGULL_PROC_TCP4_PATH=/proc/net/tcp
SEAGULL_PROC_TCP6_PATH=/proc/net/tcp6

SEAGULL_SKIP_LOOPBACK=true
SEAGULL_SKIP_LINK_LOCAL=true
SEAGULL_SKIP_PRIVATE_TO_PRIVATE=false

SEAGULL_PROC_DROP_LIKELY_OUTBOUND=true
SEAGULL_EPHEMERAL_PORT_MIN=49152

SEAGULL_DEDUP_TTL=30s
SEAGULL_ESTABLISHED_TTL=10m

SEAGULL_DENY_CIDRS=
SEAGULL_DENY_DST_PORTS=
SEAGULL_DENY_SRC_PORTS=

SEAGULL_LATERAL_MODE=pcap

SEAGULL_LOG_LEVEL=info
