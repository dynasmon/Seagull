NETWATCH_AGENT_ID=agent-core-1
NETWATCH_API_URL=https://127.0.0.1:8443/agent
NETWATCH_SOURCES=authlog,proc,scan,ddos,syscollector,vuln

NETWATCH_POLL_INTERVAL=1s
NETWATCH_HTTP_TIMEOUT=10s
NETWATCH_SENDER_MAX_BATCH=300

NETWATCH_AGENT_CONFIG_FILE=/var/lib/netwatch/agent.config.json
NETWATCH_AGENT_CREDENTIAL_FILE=/var/lib/netwatch/agent.credential

NETWATCH_AGENT_BOOTSTRAP_TOKEN=
NETWATCH_AGENT_BOOTSTRAP_TOKEN_FILE=/var/lib/netwatch/bootstrap.token
NETWATCH_AGENT_CREDENTIAL=

NETWATCH_TLS_CA_FILE=/etc/netwatch/pki/root_ca.crt
NETWATCH_TLS_CERT_FILE=
NETWATCH_TLS_KEY_FILE=
NETWATCH_TLS_SERVER_NAME=

NETWATCH_CONTROL_HEARTBEAT_EVERY=30s
NETWATCH_CONTROL_HEARTBEAT_JITTER=5s
NETWATCH_CONTROL_CONFIG_EVERY=5m
NETWATCH_CONTROL_CONFIG_JITTER=30s
NETWATCH_CONTROL_RESPONSE_ACTIONS_POLL_EVERY=15s
NETWATCH_CONTROL_RESPONSE_ACTIONS_POLL_JITTER=5s
NETWATCH_CONTROL_ENROLL_TIMEOUT=10s
NETWATCH_FORCE_ENROLL_ON_START=true
NETWATCH_CONTROL_CREDENTIAL_ROTATE_EVERY=5m
NETWATCH_CONTROL_CREDENTIAL_ROTATE_BEFORE=24h

NETWATCH_RESPONSE_ACTION_STAGE_MAX=512

NETWATCH_SYSCOLLECT_EVERY=5m
NETWATCH_SYSCOLLECT_STARTUP_JITTER=45s
NETWATCH_SYSCOLLECT_CMD_TIMEOUT=10s
NETWATCH_SYSCOLLECT_MAX_OUTPUT_BYTES=8388608
NETWATCH_SYSCOLLECT_MAX_PACKAGES=50000
NETWATCH_HOST_ROOT=

NETWATCH_VULN_SCAN_EVERY=12h
NETWATCH_VULN_STARTUP_JITTER=2m
NETWATCH_VULN_OSV_URL=https://api.osv.dev
NETWATCH_VULN_MIN_SEVERITY=medium
NETWATCH_VULN_ANALYSIS_PROFILE=wazuh_like_v1
NETWATCH_VULN_EXPOSURE_ENABLED=true
NETWATCH_VULN_QUERY_BATCH_SIZE=200
NETWATCH_VULN_CMD_TIMEOUT=15s
NETWATCH_VULN_HTTP_TIMEOUT=60s
NETWATCH_VULN_MAX_OUTPUT_BYTES=8388608
NETWATCH_VULN_MAX_PACKAGES=50000
NETWATCH_VULN_HOST_ROOT=
NETWATCH_VULN_EMIT_SUMMARY_EVENT=true

NETWATCH_AUTHLOG_PATH=/var/log/auth.log
NETWATCH_AUTHLOG_INCLUDE_ACCEPTED=true
NETWATCH_AUTHLOG_DEDUP_TTL=1s

NETWATCH_DDOS_SUSTAIN_WINDOWS=1
NETWATCH_DDOS_COOLDOWN=10s
NETWATCH_DDOS_MAX_BATCH=200
NETWATCH_DDOS_BACKPRESSURE_HIGH_WATERMARK=160
NETWATCH_DDOS_BACKPRESSURE_SAMPLE_EVERY=4

NETWATCH_PROC_TCP4_PATH=/proc/net/tcp
NETWATCH_PROC_TCP6_PATH=/proc/net/tcp6

NETWATCH_SKIP_LOOPBACK=true
NETWATCH_SKIP_LINK_LOCAL=true
NETWATCH_SKIP_PRIVATE_TO_PRIVATE=false

NETWATCH_PROC_DROP_LIKELY_OUTBOUND=true
NETWATCH_EPHEMERAL_PORT_MIN=49152

NETWATCH_DEDUP_TTL=30s
NETWATCH_ESTABLISHED_TTL=10m

NETWATCH_DENY_CIDRS=
NETWATCH_DENY_DST_PORTS=
NETWATCH_DENY_SRC_PORTS=

NETWATCH_LATERAL_MODE=pcap

NETWATCH_LOG_LEVEL=info
