          "format": "time_series",
          "rawSql": "SELECT time, metric, value FROM (\n  SELECT $__timeGroupAlias(bucket_ts, '1s') AS time, 'eps' AS metric, SUM(received)::bigint AS value\n  FROM ingest_stats_1s\n  WHERE $__timeFilter(bucket_ts)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(bucket_ts, '1s') AS time, 'dropped' AS metric, SUM(dropped)::bigint AS value\n  FROM ingest_stats_1s\n  WHERE $__timeFilter(bucket_ts)\n  GROUP BY 1\n  UNION ALL\n  SELECT $__timeGroupAlias(bucket_ts, '1s') AS time, 'rejected' AS metric, SUM(rejected)::bigint AS value\n  FROM ingest_stats_1s\n  WHERE $__timeFilter(bucket_ts)\n  GROUP BY 1\n) s\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Ingest EPS / Dropped / Rejected",
      "type": "timeseries"
