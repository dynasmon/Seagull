{
  "id": null,
  "uid": "netwatch-overview",
  "title": "Dynasmon NetWatch - Overview",
  "tags": ["netwatch", "security", "network"],
  "timezone": "",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "style": "dark",
  "panels": [
    {
      "type": "stat",
      "title": "Total Events (last 1h)",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "postgres",
        "uid": "netwatch-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "netwatch-postgres"
          },
          "rawSql": "SELECT NOW() as time, COUNT(*) as value FROM net_events WHERE timestamp >= NOW() - INTERVAL '1 hour';",
          "timeColumn": "time",
          "valueColumn": "value"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Events per Minute (last 1h)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": {
        "type": "postgres",
        "uid": "netwatch-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "netwatch-postgres"
          },
          "rawSql": "SELECT date_trunc('minute', timestamp) AS time, COUNT(*) AS value FROM net_events WHERE timestamp >= NOW() - INTERVAL '1 hour' GROUP BY 1 ORDER BY 1;",
          "timeColumn": "time",
          "valueColumn": "value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Top Destination Ports (all time)",
      "id": 3,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "datasource": {
        "type": "postgres",
        "uid": "netwatch-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "netwatch-postgres"
          },
          "rawSql": "SELECT dst_port AS \"port\", COUNT(*) AS \"count\" FROM net_events WHERE dst_port IS NOT NULL GROUP BY dst_port ORDER BY COUNT(*) DESC LIMIT 10;",
          "timeColumn": "time",
          "valueColumn": "count"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Recent Events",
      "id": 4,
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 12 },
      "datasource": {
        "type": "postgres",
        "uid": "netwatch-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "netwatch-postgres"
          },
          "rawSql": "SELECT timestamp AS \"time\", agent_id, event_type, src_ip, dst_ip, dst_port, proto, bytes FROM net_events ORDER BY timestamp DESC LIMIT 50;",
          "timeColumn": "time"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Recent Alerts",
      "id": 5,
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 22 },
      "datasource": {
        "type": "postgres",
        "uid": "netwatch-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "netwatch-postgres"
          },
          "rawSql": "SELECT created_at AS \"time\", rule_id, severity, src_ip, dst_ip, dst_port, description, details::text AS details_json FROM alerts ORDER BY created_at DESC LIMIT 50;",
          "timeColumn": "time"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
