{
  "policy": {
    "_meta": {
      "project": "seagull",
      "component": "es_indexer",
      "managed_by": "seagull-es-bootstrap",
      "description": "Rollover-driven lifecycle for the hot network-events indices. min_age / rollover conditions / forcemerge / shrink are overridden from SEAGULL_ES_ILM_* at bootstrap; the values here are inspectable defaults."
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_primary_shard_size": "50gb",
            "max_age": "1d"
          },
          "set_priority": {
            "priority": 100
          }
        }
      },
      "warm": {
        "min_age": "3d",
        "actions": {
          "forcemerge": {
            "max_num_segments": 1
          },
          "set_priority": {
            "priority": 50
          },
          "migrate": {
            "enabled": false
          }
        }
      },
      "cold": {
        "min_age": "14d",
        "actions": {
          "readonly": {},
          "set_priority": {
            "priority": 0
          },
          "migrate": {
            "enabled": false
          }
        }
      },
      "delete": {
        "min_age": "90d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
