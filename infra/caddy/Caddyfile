{
	admin off
}

{$SEAGULL_CADDY_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'"
	}

	@portal_sse path /api/realtime/portal
	handle @portal_sse {
		reverse_proxy seagull-backend:8000 {
			flush_interval -1
			header_down Cache-Control "no-cache, no-transform"
			header_down X-Accel-Buffering "no"
		}
	}

	@portal_ws path /api/realtime/portal/ws
	handle @portal_ws {
		reverse_proxy seagull-backend:8000
	}

	handle_path /api/* {
		reverse_proxy seagull-backend:8000 {
			# Keep portal auth cookies scoped to the proxied /api/auth path.
			header_down Set-Cookie "(?i)Path=/auth(;|$)" "Path=/api/auth$1"
		}
	}

	handle_path /agent/* {
		reverse_proxy seagull-backend:8000
	}

	handle {
		reverse_proxy seagull-portal:8080
	}
}
