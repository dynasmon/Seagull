:8081 {
	redir https://{host}:8443{uri}
}

:8443 {
	tls /etc/seagull/tls/tls.crt /etc/seagull/tls/tls.key
	@compressible {
		not path /api/realtime/portal /api/realtime/portal/ws
	}
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=3600"
		Content-Security-Policy "default-src 'self' data: blob:; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' blob:; connect-src 'self' wss: ws:; worker-src 'self' blob:;"
	}

	@portal_ws path /api/realtime/portal/ws
	handle @portal_ws {
		uri strip_prefix /api
		reverse_proxy seagull-backend:8000 {
			transport http {
				versions 1.1
			}
		}
	}

	@portal_sse path /api/realtime/portal
	handle @portal_sse {
		uri strip_prefix /api
		reverse_proxy seagull-backend:8000 {
			flush_interval -1
			header_down Cache-Control "no-cache, no-transform"
			header_down X-Accel-Buffering "no"
		}
	}

	handle_path /api/* {
		request_body {
			max_size {$SEAGULL_EDGE_MAX_BODY:2MiB}
		}
		reverse_proxy seagull-backend:8000 {
			header_up -X-Agent-Cert-CN
			header_down Set-Cookie "(?i)Path=/auth(;|$)" "Path=/api/auth$1"
		}
	}

	handle {
		reverse_proxy seagull-portal:{$SEAGULL_PORTAL_INTERNAL_PORT:8080}
	}
}

:8444 {
	tls /etc/seagull/mtls/server.crt /etc/seagull/mtls/server.key {
		client_auth {
			mode {$SEAGULL_AGENT_MTLS_CLIENT_AUTH:require_and_verify}
			trust_pool file /etc/seagull/mtls/agent-ca.crt
		}
	}

	handle_path /agent/* {
		request_body {
			max_size {$SEAGULL_EDGE_AGENT_MAX_BODY:8MiB}
		}
		reverse_proxy seagull-backend:8000 {
			header_up X-Agent-Cert-CN {http.request.tls.client.subject}
		}
	}

	respond "Not Found" 404
}

:8445 {
	tls /etc/seagull/mtls/server.crt /etc/seagull/mtls/server.key

	@enroll {
		method POST
		path /enroll
	}
	handle @enroll {
		request_body {
			max_size {$SEAGULL_EDGE_ENROLL_MAX_BODY:256KiB}
		}
		rewrite * /agents/enroll
		reverse_proxy seagull-backend:8000 {
			header_up -X-Agent-Cert-CN
		}
	}

	respond "Not Found" 404
}
