:8081 {
	redir https://{host}:8443{uri}
}

:8443 {
	tls /etc/seagull/tls/tls.crt /etc/seagull/tls/tls.key
	@compressible {
		not path /api/realtime/portal /api/realtime/portal/ws
	}
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self' data: blob: http: https: ws: wss:; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: blob: http: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' blob:; connect-src 'self' ws: wss: http: https:; worker-src 'self' blob:;"
	}

	@portal_ws path /api/realtime/portal/ws
	handle @portal_ws {
		uri strip_prefix /api
		reverse_proxy seagull-backend:8000 {
			transport http {
				versions 1.1
			}
		}
	}

	@portal_sse path /api/realtime/portal
	handle @portal_sse {
		uri strip_prefix /api
		reverse_proxy seagull-backend:8000 {
			flush_interval -1
			header_down Cache-Control "no-cache, no-transform"
			header_down X-Accel-Buffering "no"
		}
	}

	handle_path /api/* {
		reverse_proxy seagull-backend:8000 {
			header_down Set-Cookie "(?i)Path=/auth(;|$)" "Path=/api/auth$1"
		}
	}

	handle_path /agent/* {
		reverse_proxy seagull-backend:8000
	}

	handle {
		reverse_proxy seagull-portal:{$SEAGULL_PORTAL_INTERNAL_PORT:-8080}
	}
}
