# Core ports
NETWATCH_BACKEND_PORT=8000
GRAFANA_PORT=3000

# Postgres
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=netwatch123

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Agent control-plane
NETWATCH_HTTP_TIMEOUT=10s
NETWATCH_CONTROL_HEARTBEAT_EVERY=30s
NETWATCH_CONTROL_CONFIG_EVERY=5m

# Capture defaults
NETWATCH_PCAP_IFACE=any
NETWATCH_SKIP_LOOPBACK=true
NETWATCH_SKIP_LINK_LOCAL=true
NETWATCH_DENY_CIDRS=172.24.0.0/16,172.17.0.0/16,172.18.0.0/16,172.19.0.6/16
NETWATCH_DENY_DST_PORTS=3000,8000,5432,6379

# Rules worker
NETWATCH_RULES_EVERY_SECONDS=5

# Ingest time skew tolerance (seconds)
NETWATCH_MAX_EVENT_CLOCK_SKEW_SECONDS=30

# Agent identities
AGENT_PROC_ID=agent-proc-1
AGENT_SCAN_ID=agent-scan-1
AGENT_DDOS_ID=agent-ddos-1

# DDoS tuning (lower sustain/cooldown => faster alerts, noisier)
NETWATCH_DDOS_SUSTAIN_WINDOWS=1
NETWATCH_DDOS_COOLDOWN=10s

# Optional agent identities
AGENT_LATERAL_ID=agent-lateral-1

# Optional lateral tuning
NETWATCH_LATERAL_MODE=pcap
NETWATCH_LATERAL_PCAP_IFACE=any
NETWATCH_LATERAL_PORTS=22,445,3389,5985,5986,135,139
NETWATCH_LATERAL_INCLUDE_ESTABLISHED=true
NETWATCH_LATERAL_DEDUP_TTL=5s
NETWATCH_LATERAL_MAX_BATCH=500

# Backend admin / agent config
NETWATCH_ADMIN_TOKEN=change_me_admin_token
NETWATCH_DEFAULT_AGENT_CONFIG_JSON='{"modules":{"syscollector":{"enabled":true,"every":"5m","cmd_timeout":"10s","max_output_bytes":8388608,"max_packages":50000}}}'
NETWATCH_MAX_AGENT_CONFIG_BYTES=262144

# Agent local persisted config
NETWATCH_AGENT_CONFIG_FILE=/var/lib/netwatch/agent.config.json

# Syscollector runtime defaults (used by agent containers)
NETWATCH_SYSCOLLECT_EVERY=5m
NETWATCH_SYSCOLLECT_CMD_TIMEOUT=10s
NETWATCH_SYSCOLLECT_MAX_OUTPUT_BYTES=8388608
NETWATCH_SYSCOLLECT_MAX_PACKAGES=50000
