NETWATCH_LOG_LEVEL=INFO

# Core ports
NETWATCH_BACKEND_PORT=8000
NETWATCH_EDGE_HTTP_PORT=8081
NETWATCH_EDGE_HTTPS_PORT=8443
NETWATCH_AUTO_GENERATE_CERTS=true
GRAFANA_PORT=3000

# Postgres
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
# Keep legacy dev default for compatibility with existing local postgres volumes.
POSTGRES_PASSWORD=netwatch123
POSTGRES_PASSWORD_FILE=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_dev_grafana_password_123
GF_SECURITY_ADMIN_PASSWORD_FILE=

# Agent control-plane
NETWATCH_HTTP_TIMEOUT=10s
NETWATCH_CONTROL_HEARTBEAT_EVERY=30s
NETWATCH_CONTROL_CONFIG_EVERY=5m
NETWATCH_AGENT_TLS_SERVER_NAME=localhost
NETWATCH_AGENT_SERVER_CA_FILE=./secrets/tls/ca.crt
NETWATCH_AGENT_CA_CERT_FILE=./secrets/agent-ca/ca.crt
NETWATCH_AGENT_CA_CRL_FILE=./secrets/agent-ca/ca.crl

# Capture defaults
NETWATCH_PCAP_IFACE=any
NETWATCH_SKIP_LOOPBACK=true
NETWATCH_SKIP_LINK_LOCAL=true
NETWATCH_DENY_CIDRS=172.24.0.0/16,172.17.0.0/16,172.18.0.0/16,172.19.0.6/16,192.168.200.1
NETWATCH_DENY_DST_PORTS=3000,8000,5432,6379

# Rules worker
NETWATCH_RULES_EVERY_SECONDS=5
NETWATCH_RULES_ENV=dev
NETWATCH_RULES_ENABLED_PACKS=core,network,lab
NETWATCH_RULES_DISABLED_PACKS=
NETWATCH_RULES_INCLUDE_EXPERIMENTAL=true

# Ingest time skew tolerance (seconds)
NETWATCH_MAX_EVENT_CLOCK_SKEW_SECONDS=30

# Agent identities
AGENT_PROC_ID=agent-proc-1
AGENT_SCAN_ID=agent-scan-1
AGENT_DDOS_ID=agent-ddos-1
AGENT_VULN_ID=agent-vuln-1
AGENT_CORE_ID=agent-core-1
AGENT_SENSOR_ID=agent-sensor-1
AGENT_LATERAL_ID=agent-lateral-1

AGENT_PROC_CERT_FILE=./secrets/agent-pki/agent-proc-1/tls.crt
AGENT_PROC_KEY_FILE=./secrets/agent-pki/agent-proc-1/tls.key
AGENT_SCAN_CERT_FILE=./secrets/agent-pki/agent-scan-1/tls.crt
AGENT_SCAN_KEY_FILE=./secrets/agent-pki/agent-scan-1/tls.key
AGENT_DDOS_CERT_FILE=./secrets/agent-pki/agent-ddos-1/tls.crt
AGENT_DDOS_KEY_FILE=./secrets/agent-pki/agent-ddos-1/tls.key
AGENT_LATERAL_CERT_FILE=./secrets/agent-pki/agent-lateral-1/tls.crt
AGENT_LATERAL_KEY_FILE=./secrets/agent-pki/agent-lateral-1/tls.key
AGENT_VULN_CERT_FILE=./secrets/agent-pki/agent-vuln-1/tls.crt
AGENT_VULN_KEY_FILE=./secrets/agent-pki/agent-vuln-1/tls.key
AGENT_CORE_CERT_FILE=./secrets/agent-pki/agent-core-1/tls.crt
AGENT_CORE_KEY_FILE=./secrets/agent-pki/agent-core-1/tls.key
AGENT_SENSOR_CERT_FILE=./secrets/agent-pki/agent-sensor-1/tls.crt
AGENT_SENSOR_KEY_FILE=./secrets/agent-pki/agent-sensor-1/tls.key

AGENT_PROC_BOOTSTRAP_TOKEN=abt.agent-proc-1.jMV6sUJCeM5jFcBtezoQZxjPohKGO7oWeZAeVEApAek
AGENT_SCAN_BOOTSTRAP_TOKEN=abt.agent-scan-1.qTWtCge1_d_R3fhDx_kNy4iwk2G9yDFPDNe-ibJrb8M
AGENT_DDOS_BOOTSTRAP_TOKEN=abt.agent-ddos-1.RLr59KlXqjgofpnDf0oPad4iuoa0ugNvLBr_0bqjHys
AGENT_LATERAL_BOOTSTRAP_TOKEN=abt.agent-lateral-1.oFfeOlpUas5C384YkSVAwV_slahi2WZEqVk1klhXQXA
AGENT_VULN_BOOTSTRAP_TOKEN=abt.agent-vuln-1.dsjLOSxMzXkVRR7FLjDAiczLsuKZedbAR7Q8eF7zSIw

# DDoS tuning (lower sustain/cooldown => faster alerts, noisier)
NETWATCH_DDOS_SUSTAIN_WINDOWS=1
NETWATCH_DDOS_COOLDOWN=10s
NETWATCH_DDOS_MAX_BATCH=200
# Start shedding packet-processing work when internal queue reaches this size.
NETWATCH_DDOS_BACKPRESSURE_HIGH_WATERMARK=160
# While backpressured, process 1 out of N packets.
NETWATCH_DDOS_BACKPRESSURE_SAMPLE_EVERY=4

# Ssh agent

NETWATCH_AUTHLOG_DEDUP_TTL=1s
NETWATCH_AUTHLOG_INCLUDE_ACCEPTED=true

# Optional lateral tuning
NETWATCH_LATERAL_MODE=pcap
NETWATCH_LATERAL_PCAP_IFACE=any
NETWATCH_LATERAL_PORTS=22,445,3389,5985,5986,135,139
NETWATCH_LATERAL_INCLUDE_ESTABLISHED=true
NETWATCH_LATERAL_DEDUP_TTL=5s
NETWATCH_LATERAL_MAX_BATCH=500

# --------------------------------
# Portal auth (JWT + refresh tokens)
# --------------------------------
# Strong secret (>= 32 chars). Generate with:
#   openssl rand -hex 32
NETWATCH_JWT_SECRET=change_me_dev_jwt_secret_at_least_32_chars_long
NETWATCH_JWT_SECRET_FILE=

# First-run admin bootstrap (required on empty DB). Must be >= 12 chars.
NETWATCH_BOOTSTRAP_ADMIN_USERNAME=admin
NETWATCH_BOOTSTRAP_ADMIN_PASSWORD=change_me_dev_bootstrap_admin_password_123
NETWATCH_BOOTSTRAP_ADMIN_PASSWORD_FILE=
NETWATCH_BOOTSTRAP_ADMIN_RESET_ON_START=true

# Optional extra pepper for hashing refresh/OTP tokens at rest.
NETWATCH_TOKEN_PEPPER=

# Access token TTL (seconds) + refresh TTL (seconds)
NETWATCH_ACCESS_TOKEN_TTL_SECONDS=600
NETWATCH_REFRESH_TOKEN_TTL_SECONDS=604800
NETWATCH_OTP_TOKEN_TTL_SECONDS=900

# Cookies (set COOKIE_SECURE=true when behind HTTPS)
NETWATCH_COOKIE_SECURE=false
NETWATCH_COOKIE_SAMESITE=lax
NETWATCH_COOKIE_DOMAIN=

NETWATCH_AGENT_BOOTSTRAP_TOKEN_TTL_SECONDS=900
NETWATCH_AGENT_BOOTSTRAP_TOKEN_MAX_USES=1
NETWATCH_FORCE_ENROLL_ON_START=true
NETWATCH_DEFAULT_AGENT_CONFIG_JSON='{"modules":{"syscollector":{"enabled":true,"every":"5m","cmd_timeout":"10s","max_output_bytes":8388608,"max_packages":50000}}}'
NETWATCH_MAX_AGENT_CONFIG_BYTES=262144

# Agent local persisted config
NETWATCH_AGENT_CONFIG_FILE=/var/lib/netwatch/agent.config.json

# Syscollector runtime defaults (used by agent containers)
NETWATCH_SYSCOLLECT_EVERY=5m
NETWATCH_SYSCOLLECT_CMD_TIMEOUT=10s
NETWATCH_SYSCOLLECT_MAX_OUTPUT_BYTES=8388608
NETWATCH_SYSCOLLECT_MAX_PACKAGES=50000

# -----------------------------
# Vulnerability Scanner (OSV)
# -----------------------------
# NOTE: the vuln agent mounts the host rootfs read-only at /host.
NETWATCH_VULN_SCAN_EVERY=12h
NETWATCH_VULN_HTTP_TIMEOUT=60s
NETWATCH_VULN_OSV_URL=https://api.osv.dev
NETWATCH_VULN_MIN_SEVERITY=medium
NETWATCH_VULN_QUERY_BATCH_SIZE=200
NETWATCH_VULN_CMD_TIMEOUT=15s
NETWATCH_VULN_MAX_PACKAGES=50000
NETWATCH_VULN_HOST_ROOT=/host
NETWATCH_VULN_EMIT_SUMMARY_EVENT=true

# -----------------------------
# Vulnerability Scanner (SBOM: CycloneDX via syft)
# -----------------------------
# Generates CycloneDX SBOMs and queries OSV for application dependencies.
# Targets are comma-separated paths inside the agent container (host root is mounted at /host).
NETWATCH_VULN_SBOM_ENABLED=true
NETWATCH_VULN_SBOM_PATHS=/host/srv,/host/var/www,/host/opt,/host/home/nathan
NETWATCH_VULN_SBOM_TIMEOUT=8m
NETWATCH_VULN_SBOM_MAX_COMPONENTS=20000
NETWATCH_VULN_SBOM_SYFT_PATH=/usr/local/bin/syft

# -----------------------------
# Elasticsearch (search / hunting)
# -----------------------------
# Single-node defaults are tuned for small VPS labs. Start Kibana with:
#   docker compose --profile extra up -d
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Elasticsearch URL as seen by containers.
NETWATCH_SEARCH_BACKEND=auto
NETWATCH_ES_URL=http://elasticsearch:9200
NETWATCH_ES_INDEX_PREFIX=netwatch-events
NETWATCH_ES_BATCH_SIZE=500
NETWATCH_ES_EVERY_SECONDS=1
NETWATCH_ES_IDLE_SLEEP_SECONDS=2
NETWATCH_ES_REQUEST_TIMEOUT_SECONDS=30
NETWATCH_ES_USERNAME=elastic
NETWATCH_ES_PASSWORD=
NETWATCH_ES_PASSWORD_FILE=
NETWATCH_ES_VERIFY_CERTS=true
NETWATCH_ES_CA_CERTS=
NETWATCH_ES_PING_TTL_SECONDS=2
NETWATCH_ES_BOOTSTRAP=true
NETWATCH_REDIS_USERNAME=
NETWATCH_REDIS_PASSWORD=
NETWATCH_REDIS_PASSWORD_FILE=

# Backend performance tuning
NETWATCH_UVICORN_WORKERS=2
NETWATCH_DB_POOL_SIZE=10
NETWATCH_DB_MAX_OVERFLOW=20
NETWATCH_DB_EXECUTEMANY_MODE=values_plus_batch
NETWATCH_DB_EXECUTEMANY_VALUES_PAGE_SIZE=1000

# Rollup worker (reduce Grafana/Postgres load)
NETWATCH_ROLLUP_EVERY_SECONDS=1
NETWATCH_ROLLUP_IDLE_SLEEP_SECONDS=2
NETWATCH_ROLLUP_MAX_ROWS=5000

# Ingest storm control (protect Postgres under volumetric attacks)
NETWATCH_INGEST_MAX_BATCH=2000
NETWATCH_INGEST_STORM_EVENTS_PER_SECOND=4000
NETWATCH_INGEST_STORM_MIN_BATCH=2500
NETWATCH_INGEST_STORM_TTL_SECONDS=30
NETWATCH_INGEST_STORM_SAMPLE_PERCENT=2
NETWATCH_INGEST_ROLLUP_ALWAYS=false
NETWATCH_INGEST_VALUES_PAGE_SIZE=5000
NETWATCH_INGEST_ROLLUP_PAGE_SIZE=2500
# Ingest backpressure (Redis queue)
NETWATCH_INGEST_QUEUE_KEY=netwatch:ingest:queue
NETWATCH_INGEST_PROCESSING_KEY=netwatch:ingest:queue:processing
NETWATCH_INGEST_WORKER_BATCH_MESSAGES=500
NETWATCH_INGEST_WORKER_IDLE_SLEEP_SECONDS=0.25
NETWATCH_INGEST_BACKPRESSURE_SOFT_BACKLOG_EVENTS=5000
NETWATCH_INGEST_BACKPRESSURE_HARD_BACKLOG_EVENTS=40000
NETWATCH_INGEST_BACKPRESSURE_MODE=rollup_only
NETWATCH_INGEST_BACKPRESSURE_WARM_SAMPLE_PERCENT=2

# Hot/Warm sampling
NETWATCH_INGEST_WARM_ENABLED=true
NETWATCH_INGEST_WARM_SAMPLE_PERCENT=0
NETWATCH_INGEST_WARM_INDEX_PREFIX=netwatch-events-warm
NETWATCH_INGEST_WARM_ILM_ENABLED=true
NETWATCH_INGEST_WARM_ILM_POLICY=netwatch-warm-delete-30d
NETWATCH_INGEST_WARM_ILM_DELETE_AFTER_DAYS=30
NETWATCH_INGEST_STORM_HOT_SAMPLE_PERCENT=2
NETWATCH_INGEST_STORM_WARM_SAMPLE_PERCENT=5
NETWATCH_INGEST_STORM_ALERT_TTL_SECONDS=3600

# Elasticsearch ILM
NETWATCH_ES_ILM_ENABLED=true
NETWATCH_ES_ILM_DELETE_AFTER_DAYS=30
NETWATCH_ES_ILM_POLICY_NAME=



# -----------------------------
# Attack Chain (stateful kill-chain cases)
# -----------------------------
NETWATCH_ATTACK_CHAIN_EVERY_SECONDS=1.0
NETWATCH_ATTACK_CHAIN_IDLE_SLEEP_SECONDS=2.0
NETWATCH_ATTACK_CHAIN_BATCH_SIZE=500

# Worker logs
# - LOG_EVERY: prints an "ok" line with detailed counters at most every N seconds
# - LOG_IDLE_EVERY: prints an "idle" heartbeat when there are no new events
# - DEBUG: prints one line per inserted step (useful for tuning detectors)
NETWATCH_ATTACK_CHAIN_LOG_EVERY_SECONDS=2.0
NETWATCH_ATTACK_CHAIN_LOG_IDLE_EVERY_SECONDS=20.0
NETWATCH_ATTACK_CHAIN_DEBUG=false

# Auto-close open cases that went idle (seconds)
NETWATCH_ATTACK_CHAIN_IDLE_CLOSE_SECONDS=2700

# Attach local-only steps (sudo/exec/persistence) to the latest open case for the agent (seconds)
NETWATCH_ATTACK_CHAIN_ATTACH_LOCAL_WINDOW_SECONDS=1200

# Deduplicate identical steps within this window (seconds)
NETWATCH_ATTACK_CHAIN_STEP_DEDUP_SECONDS=60

NETWATCH_ATTACK_CHAIN_MAX_SCORE=100

# SSH correlation tuning
NETWATCH_ATTACK_CHAIN_SSH_FAIL_WINDOW_SECONDS=600
NETWATCH_ATTACK_CHAIN_SSH_FAIL_THRESHOLD=6
NETWATCH_ATTACK_CHAIN_SSH_BRUTEFORCE_SCORE=28
NETWATCH_ATTACK_CHAIN_SSH_BRUTEFORCE_SUCCESS_SCORE=34
NETWATCH_ATTACK_CHAIN_SSH_NEW_SOURCE_SCORE=14

# Sudo correlation tuning
NETWATCH_ATTACK_CHAIN_SUDO_EXEC_SCORE=6
NETWATCH_ATTACK_CHAIN_SUDO_LOLBIN_SCORE=14
NETWATCH_ATTACK_CHAIN_SUDO_PRIV_ESCALATION_SCORE=24
NETWATCH_ATTACK_CHAIN_SUDO_REMOTE_EXEC_SCORE=26
NETWATCH_ATTACK_CHAIN_SUDO_DEF_EVASION_SCORE=30

# -----------------------------
# IP Intelligence (Geo/ASN for SSH Insights)
# -----------------------------
# Primary mode: local MaxMind GeoLite2 MMDB databases mounted inside the worker.
# Drop the files below into backend/data/geoip/ on the host.
NETWATCH_IP_INTEL_PROVIDER=auto
NETWATCH_IP_INTEL_FALLBACK_PROVIDER=ipinfo
NETWATCH_IP_INTEL_MAXMIND_CITY_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb
NETWATCH_IP_INTEL_MAXMIND_ASN_DB_PATH=/app/data/geoip/GeoLite2-ASN.mmdb
# Optional fallback only. Leave empty if you want local-only enrichment.
NETWATCH_IPINFO_TOKEN=
NETWATCH_IP_INTEL_EVERY_SECONDS=1
NETWATCH_IP_INTEL_IDLE_SLEEP_SECONDS=2
NETWATCH_IP_INTEL_MAX_ROWS=2000
NETWATCH_IP_INTEL_BATCH_SIZE=200
NETWATCH_IP_INTEL_HTTP_TIMEOUT_SECONDS=8
NETWATCH_IP_INTEL_CACHE_TTL_DAYS=7
NETWATCH_IP_INTEL_SKIP_PRIVATE=true

# Protocol Intelligence (DNS/HTTP/TLS)
NETWATCH_PROTO_INTEL_EVERY_SECONDS=1.0
NETWATCH_PROTO_INTEL_IDLE_SLEEP_SECONDS=2.0
NETWATCH_PROTO_INTEL_MAX_ROWS=5000
NETWATCH_PROTO_INTEL_BATCH_SIZE=500
NETWATCH_PROTO_INTEL_PAYLOAD_MAX_BYTES=4096
NETWATCH_PROTO_INTEL_PORT_HINTS=


NETWATCH_PORTAL_PORT=8888

# -----------------------------
# Vulnerability Findings (scanner ingest)
# -----------------------------
NETWATCH_VULN_MAX_FINDINGS_PER_INGEST=2000
NETWATCH_VULN_MAX_EVIDENCE_BYTES=32768
NETWATCH_VULN_AUTO_REOPEN=true

# -----------------------------
# Agent Vulnerability Scanner (Wazuh-like profile)
# -----------------------------
# Uses host package inventory + OSV correlation + exposure-aware prioritization.
NETWATCH_VULN_ANALYSIS_PROFILE=wazuh_like_v1
NETWATCH_VULN_EXPOSURE_ENABLED=true

